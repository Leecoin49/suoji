{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "琐记",
  "version": "0.1.2",
  "identifier": "com.tool.suoji",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "琐记",
        "width": 760,
        "height": 780,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMzg5RDkwQUVFNzFFRjYKUldUMkh1ZXVrSjA0ejl2dVFPUXJJNFBrVlJLMjRCNWxKaWY3b2pTOEN1T2IyK0twVjFrbCtTMSsK",
      "endpoints": [
        "https://github.com/Leecoin49/suoji/releases/latest/download/latest.json"
      ]
    }
  }
}
