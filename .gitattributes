# Normalize all text files to LF in the repository so Windows checkouts,
# macOS checkouts and CI agree on byte content.
* text=auto eol=lf

# Source
*.rs    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ps1   text eol=lf
*.nsi   text eol=lf

# Binaries — never convert, never diff as text
*.png   binary
*.ico   binary
*.icns  binary
*.exe   binary
*.dll   binary
*.msi   binary

# Build output that occasionally lands in the working tree should not pollute
# review diffs.
dist/**          -diff linguist-generated
src-tauri/target/** -diff linguist-generated
